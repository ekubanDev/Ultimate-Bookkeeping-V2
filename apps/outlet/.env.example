# Firebase web auth config for the Outlet app (apps/outlet/src/auth/firebase.js).
# Copy this file to .env.local (or .env) and fill in real values from the
# Firebase console for this project — never commit the filled-in file
# (.env and .env.* are gitignored; this .example file is the sole exception).
#
# If these are absent, the app boots into a clearly-labeled "auth not
# configured" state instead of crashing or silently pretending to be signed
# in — see isFirebaseConfigured in src/auth/firebase.js.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
