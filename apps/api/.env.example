# Ultimate Bookkeeping API (apps/api) — environment variables.
#
# Copy this file to `.env` (or export the same variables in your shell /
# Cursor's run config) and fill in values for your setup. `.env` itself is
# gitignored; this `.example` file is the tracked template (see
# /.gitignore's `!.env.example` negation) — never commit real credentials
# here or in `.env`.
#
# Nothing in this file is loaded automatically by the app at runtime today
# (app/db.py, app/auth.py, app/rate_limit.py all read os.environ directly,
# with no `python-dotenv`/`load_dotenv()` call anywhere in app/). Load it
# yourself before running anything, e.g.:
#   set -a; source .env; set +a; uvicorn app.main:app --reload
# or use `python-dotenv`'s `dotenv run -- <command>` if you have it
# installed, or configure Cursor's launch/run config to inject these vars.

# --- Database ---------------------------------------------------------------

# Required in every mode (dev server, alembic, tests-against-Postgres).
# asyncpg driver, matches app/db.py + alembic/env.py. If unset, app/db.py
# falls back to postgresql+asyncpg://localhost/ultimate_bookkeeping — that
# default assumes a local Postgres with no password on the invoking OS user,
# which is rarely true; setting this explicitly is strongly recommended.
# The plain pytest run (no DATABASE_URL) does NOT need this — it uses an
# in-memory SQLite engine instead (see tests/conftest.py).
DATABASE_URL=postgresql+asyncpg://ubk:ubk@localhost:5432/ultimate_bookkeeping

# --- Firebase Admin SDK (token verification, app/auth.py) -------------------

# Needed in every mode that verifies real tokens (i.e. not needed for
# `pytest`, which overrides auth entirely — see tests/conftest.py).
#
# Two ways to configure the Admin SDK, pick ONE:
#
#   1. Local dev against the Firebase Auth EMULATOR (recommended for running
#      the app locally with no GCP project at all):
#        - Set FIREBASE_AUTH_EMULATOR_HOST below.
#        - Set FIREBASE_PROJECT_ID to any string that matches your emulator
#          config (e.g. the "default" project in .firebaserc) — it does NOT
#          need to be a real GCP/Firebase project.
#        - Leave GOOGLE_APPLICATION_CREDENTIALS unset. No service-account
#          key is read or needed on this path — see app/auth.py
#          (`_ensure_firebase_app` docstring) for exactly why.
#        - Start the emulator yourself: `firebase emulators:start --only
#          auth` (requires the `firebase-tools` CLI — `npm install -g
#          firebase-tools`; no `firebase login` or real Google account
#          needed to just run the emulator).
#
#   2. Against a real Firebase project (staging/prod, or a dev who wants
#      real Google Sign-In end to end):
#        - Set FIREBASE_PROJECT_ID to the real project id.
#        - Set GOOGLE_APPLICATION_CREDENTIALS to the absolute path of a
#          downloaded service-account JSON key for that project (Firebase
#          console -> Project settings -> Service accounts -> Generate new
#          private key). Never commit that file.
#        - Leave FIREBASE_AUTH_EMULATOR_HOST UNSET.

# Local Firebase Auth emulator host:port. LOCAL DEVELOPMENT ONLY — see
# app/auth.py for exactly what this does and why it is safe (it changes
# nothing unless this variable is explicitly set). NEVER set this in a
# deployed/production environment: doing so makes the API accept
# locally-forged, unsigned "tokens" for any uid.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Project id used to construct the Admin SDK app (app/auth.py). Required
# whichever of the two modes above you use.
# FIREBASE_PROJECT_ID=ultimate-bookkeeping-dev

# Absolute path to a service-account JSON key. Only used/needed for mode 2
# above (real Firebase project, no emulator) — never set this alongside
# FIREBASE_AUTH_EMULATOR_HOST, and never commit the key file itself.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Rate limiting (app/rate_limit.py) --------------------------------------

# Defaults to enabled (true) if unset — that default is what production
# runs with and must not be changed there. Read exactly once, at import
# time (before app.main is first imported), so this has to be set in the
# environment before the process starts, not toggled at runtime.
# Local dev: leave this at the default (true/unset) to exercise real 429s,
# or set to "false" temporarily if a rate limit is getting in the way of
# manual testing/exploration. Tests set this to "false" for themselves
# automatically (tests/conftest.py) — you don't need to set it to run
# `pytest`.
RATE_LIMIT_ENABLED=true
