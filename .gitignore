# JS/TS
node_modules/
dist/
# Bundle-analysis output (rollup-plugin-visualizer et al) — regenerated on
# demand, never a build input.
dist-analyze/
*.local

# Python (apps/api)
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Service-account keys and other credentials. A Firebase Admin SDK key
# grants full project access (minting tokens, impersonating any user) — it
# must never reach the repo. Point GOOGLE_APPLICATION_CREDENTIALS at a path
# outside the working tree, or use one of these names if you must keep it here.
*serviceAccount*.json
*service-account*.json
*-adminsdk-*.json
*.pem
*.p12

# Env & editor
.env
.env.*
!.env.example
!apps/outlet/.env.example
.DS_Store

# Firebase CLI / emulator debug logs. Untracked churn, but the reason
# they're ignored rather than just deleted is that they're durable
# artifacts of commands whose output is not meant to be durable — the
# emulator ones carry the operator's CLI-auth Google account, and the
# same CLI writes these next to any command you run, including ones
# whose stdout carries one-time credentials (see the reset-link warning
# in apps/api/scripts/seed_dev.py's `_seed_firebase_real_users`).
*-debug.log
firebase-debug.log
ui-debug.log

# Catalog / inventory exports. This repository is PUBLIC: a product CSV is a
# business's supplier pricing and stock position, and committing one
# publishes it. Keep them outside the repo and pass a path to
# apps/api/scripts/import_catalog.py.
catalog*.csv
inventory*.csv
*_export*.csv
